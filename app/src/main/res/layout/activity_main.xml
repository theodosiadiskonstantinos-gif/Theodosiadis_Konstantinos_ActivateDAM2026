<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <Button
        android:id="@+id/btnAddTikTok"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Adauga TikTok (Normal)" />

    <Button
        android:id="@+id/btnViewList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Vezi Lista TikToks" />

    <Button
        android:id="@+id/btnOpenAiDesign"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Adauga TikTok (AI Design)" />

    <TextView
        android:id="@+id/tvDisplayResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp" />

</LinearLayout>